<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue3">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/arrow"
        android:textSize="22sp"
        android:gravity="center"
        android:clickable="true"
        android:padding="9dp"
        android:focusable="true"
        android:contentDescription="@string/voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="33dp" />

    <TextView
        android:id="@+id/txtTopo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reminders"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="@font/inter24_semibold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <View
        android:id="@+id/linhaTopo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/blue11"
        app:layout_constraintTop_toBottomOf="@id/txtTopo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <ScrollView
        android:id="@+id/scrollLembretes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/linhaTopo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_reminders"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/inter24_bold" />

            <!-- Aviso de Notificações Desativadas -->
            <TextView
                android:id="@+id/txtAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_off"
                android:textColor="@color/yellow2"
                android:textSize="13sp"
                android:fontFamily="@font/inter24_medium"
                android:background="@drawable/bg_search_input"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_info"
                android:textColor="@color/grey2"
                android:fontFamily="@font/inter24_regular"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders_meal"
                android:textColor="@color/grey2"
                android:textSize="15sp"
                android:fontFamily="@font/inter24_semibold"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="8dp" />

            <!-- Café da Manhã -->
            <LinearLayout
                android:id="@+id/cardCafe"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/iccafe"
                    android:textSize="20sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/breakf"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter24_semibold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraCafe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_bf"
                        android:fontFamily="@font/inter24_regular"
                        android:textColor="@color/grey2"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCafe"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

            <!-- Almoço -->
            <LinearLayout
                android:id="@+id/cardAlmoco"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/icalmoco"
                    android:textSize="20sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lunch"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter24_semibold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraAlmoco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_lunch"
                        android:textColor="@color/grey2"
                        android:fontFamily="@font/inter24_regular"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAlmoco"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

            <!-- Lanche da tarde -->
            <LinearLayout
                android:id="@+id/cardLanche"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/iclanche"
                    android:textColor="@color/blue11"
                    android:textSize="24sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/snack"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter24_semibold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraLanche"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_snack"
                        android:textColor="@color/grey2"
                        android:fontFamily="@font/inter24_regular"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLanche"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="false"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

            <!-- Jantar -->
            <LinearLayout
                android:id="@+id/cardJantar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/icjantar"
                    android:textSize="20sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dinner"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter24_semibold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraJantar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_dinner"
                        android:textColor="@color/grey2"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter24_regular"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchJantar"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hidro"
                android:textColor="@color/grey2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <!-- Água -->
            <LinearLayout
                android:id="@+id/cardAgua"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/icagua"
                    android:textSize="20sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drink_water"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter24_semibold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraAgua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_water"
                        android:textColor="@color/grey2"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter24_regular"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAgua"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health"
                android:textColor="@color/grey2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <!-- Hora de Dormir -->
            <LinearLayout
                android:id="@+id/cardDormir"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/iclua"
                    android:textColor="@color/bluelight2"
                    android:textSize="25sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_time"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter24_semibold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHoraDormir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_sleep"
                        android:textColor="@color/grey2"
                        android:fontFamily="@font/inter24_regular"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDormir"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    app:thumbTint="@color/green2"
                    app:trackTint="@color/white"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>