<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradientbg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    tools:context=".ForgotFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/icarrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/arrow"
            android:scaleType="fitStart"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:contentDescription="@string/voltar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="80dp"
            android:layout_marginStart="15dp"/>

        <ImageView
            android:id="@+id/logo_preview"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/iclogo"
            android:layout_marginBottom="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="115dp"/>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter24_bold"
            android:text="@string/forgot_pass"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="225dp"/>

        <TextView
            android:id="@+id/emaildig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter24_medium"
            android:text="@string/insert_current_email"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/login_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:textColor="@android:color/black"
            android:textColorHint="@color/grey"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:padding="13dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:drawableStart="@drawable/letter"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/emaildig"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/forgotbtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:padding="13dp"
            android:text="@string/receive_email"
            android:fontFamily="@font/istokweb_bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/green1"
            app:layout_constraintTop_toBottomOf="@id/login_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtDetalhe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter24_medium"
            android:text="@string/forgot_desc"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toBottomOf="@id/forgotbtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
