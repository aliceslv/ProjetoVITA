<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewAbout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue3"
    android:fillViewport="true"
    tools:context=".AboutFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Botão Voltar -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Voltar"
            android:src="@drawable/arrow"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:tint="@color/white" />

        <!-- Título do Ecrã -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="Sobre nós"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/inter24_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ícone da Aplicação -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_logo_container"
            android:padding="20dp"
            android:src="@drawable/info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:tint="@color/green2" />

        <!-- Nome da Aplicação -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Vita"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:fontFamily="@font/inter24_bold"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <!-- Card de Descrição -->
        <LinearLayout
            android:id="@+id/cardAbout"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_about"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName">

            <TextView
                android:id="@+id/tvAboutDesc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Vita ajuda você a manter o foco na sua jornada de saúde, registrando refeições, peso e hábitos com simplicidade."
                android:textColor="@color/white"
                android:fontFamily="@font/inter24_medium"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvAboutDesc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Acreditamos que pequenas conquistas diárias constroem grandes transformações."
                android:textColor="@color/grey2"
                android:fontFamily="@font/inter24_medium"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Rodapé (Footer) -->
        <TextView
            android:id="@+id/tvFooterMadeBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feito com ♡ pela equipe VITA"
            android:textColor="@color/grey2"
            android:textSize="15sp"
            android:fontFamily="@font/inter24_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="550dp"/>

        <TextView
            android:id="@+id/tvFooterCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="© 2026 VITA. Todos os direitos reservados."
            android:textColor="@color/grey3"
            android:textSize="13sp"
            android:fontFamily="@font/inter24_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFooterMadeBy" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>