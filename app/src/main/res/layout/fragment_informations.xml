<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InformationsFragment"
    android:background="@drawable/gradientbg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/icarrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/arrow"
            android:scaleType="fitStart"
            android:clickable="true"
            android:padding="8dp"
            android:contentDescription="@string/voltar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="125dp"
            android:layout_marginStart="15dp"/>

        <ImageView
            android:id="@+id/iclogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/iclogo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/give_personal"
            android:fontFamily="@font/inter24_bold"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="170dp"
            android:layout_marginStart="30dp"/>

        <TextView
            android:id="@+id/txtsubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_info"
            android:fontFamily="@font/inter24_italic"
            android:textColor="@color/grey2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:layout_constraintStart_toStartOf="@id/txtTitulo"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txtpeso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_kg"
            android:fontFamily="@font/inter24_semibold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/txtsubtitulo"
            app:layout_constraintTop_toBottomOf="@id/txtsubtitulo"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/edtPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/kg_hint"
            android:textColor="@color/black"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/grey"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:padding="13dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@id/txtpeso"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtaltura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/height_cm"
            android:fontFamily="@font/inter24_semibold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/txtpeso"
            app:layout_constraintTop_toBottomOf="@id/edtPeso"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edtAltura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/height_hint"
            android:textColor="@color/black"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/grey"
            android:textSize="16sp"
            android:inputType="number"
            android:padding="13dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@id/txtaltura"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtpesometa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_goal"
            android:fontFamily="@font/inter24_semibold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/txtpeso"
            app:layout_constraintTop_toBottomOf="@id/edtAltura"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edtPesoMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/weight_goal_hint"
            android:textColor="@color/black"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/grey"
            android:textSize="16sp"
            android:inputType="number"
            android:padding="13dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@id/txtpesometa"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtsexo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender"
            android:fontFamily="@font/inter24_semibold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/txtpeso"
            app:layout_constraintTop_toBottomOf="@id/edtPesoMeta"
            android:layout_marginTop="30dp"/>

        <Spinner
            android:id="@+id/spinnerSexo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtsexo"
            android:background="@drawable/dropdownbg"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:spinnerMode="dropdown"/>

        <TextView
            android:id="@+id/txtnasc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/birth_date"
            android:fontFamily="@font/inter24_semibold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/txtpeso"
            app:layout_constraintTop_toBottomOf="@id/spinnerSexo"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edtNasc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 20/02/2000"
            android:textColor="@color/black"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/grey"
            android:textSize="16sp"
            android:inputType="date"
            android:padding="13dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@id/txtnasc"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/continueBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:padding="13dp"
            android:text="@string/continuar"
            android:backgroundTint="@color/green1"
            android:fontFamily="@font/istokweb_bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/edtNasc"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>