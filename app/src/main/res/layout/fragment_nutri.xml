<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue3">

    <!-- ScrollView limita sua área acima da barraInferior -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/barraInferior">

        <!-- ConstraintLayout gerencia o conteúdo interno -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                android:contentDescription="Perfil"
                android:scaleType="centerInside"
                android:src="@drawable/profile2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtSemana"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/rounded_corner4"
                android:backgroundTint="@color/blue4"
                android:fontFamily="@font/inter24_medium"
                android:gravity="center"
                android:text="Essa Semana"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgPerfil" />

            <LinearLayout
                android:id="@+id/menuNutri"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSemana">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter24_semibold"
                    android:gravity="center"
                    android:text="CALORIAS"
                    android:textColor="@color/grey2"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter24_semibold"
                    android:gravity="center"
                    android:text="MACROS"
                    android:textColor="@color/green1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter24_semibold"
                    android:gravity="center"
                    android:text="NUTRIENTES"
                    android:textColor="@color/grey2"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/txtNutri"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:paddingStart="25dp"
                android:paddingEnd="25dp"
                app:layout_constraintTop_toBottomOf="@+id/menuNutri">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nutrientes"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média Diária"
                    android:textColor="#8493A5"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Alterado layout_height de 400dp para wrap_content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="23dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="23dp"
                android:background="@drawable/rounded_corner3"
                android:orientation="vertical"
                android:padding="13dp"
                app:layout_constraintTop_toBottomOf="@id/txtNutri">

                <!-- FIBRAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter24_medium"
                        android:text="Fibras"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="22 / 25g"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:max="25"
                    android:progress="22"
                    android:progressBackgroundTint="#08243A"
                    android:progressTint="#20D36B" />

                <!-- AÇÚCAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter24_medium"
                        android:text="Açúcar"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="45 / 50g"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:max="50"
                    android:progress="45"
                    android:progressBackgroundTint="#08243A"
                    android:progressTint="#20D36B" />

                <!-- SÓDIO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter24_medium"
                        android:text="Sódio"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="1800 / 2300mg"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:max="2300"
                    android:progress="1800"
                    android:progressBackgroundTint="#08243A"
                    android:progressTint="#20D36B" />

                <!-- COLESTEROL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter24_medium"
                        android:text="Colesterol"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="210 / 300mg"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:max="300"
                    android:progress="210"
                    android:progressBackgroundTint="#08243A"
                    android:progressTint="#20D36B" />

                <!-- GORDURAS SATURADAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter24_medium"
                        android:text="Gorduras Saturadas"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="18 / 20g"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:max="20"
                    android:progress="18"
                    android:progressBackgroundTint="#08243A"
                    android:progressTint="#20D36B" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Barra Inferior fixada permanentemente no rodapé -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:background="@color/blue2"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnUsuario"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="Perfil"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/icuser" />

        <ImageView
            android:id="@+id/btnLivro"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="Diário"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/iclivro" />

        <ImageView
            android:id="@+id/btnEscala"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="Calorias"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/icescala" />

    </LinearLayout>

</RelativeLayout>