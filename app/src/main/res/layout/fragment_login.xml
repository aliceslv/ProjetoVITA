<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradientbg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="20dp"
    tools:context=".LoginFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/icarrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/arrow"
            android:scaleType="fitStart"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:contentDescription="@string/voltar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="80dp"
            android:layout_marginStart="15dp"/>

        <ImageView
            android:id="@+id/iclogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/iclogo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="86dp"/>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_str"
            android:fontFamily="@font/inter24_bold"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.01"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="190dp"/>

        <LinearLayout
            android:id="@+id/layoutCriarConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtNaoTemConta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_account"
                android:fontFamily="@font/inter24_medium"
                android:textColor="@color/white"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/createBtn2"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/create_acc"
                android:fontFamily="@font/istokweb_bold"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue5"
                android:padding="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEsqueceuSenha"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            app:layout_constraintTop_toBottomOf="@id/layoutCriarConta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtEsqueceuSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esqueceu"
                android:fontFamily="@font/inter24_medium"
                android:textColor="@color/white"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/forgotBtn3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/recover_pass"
                android:fontFamily="@font/istokweb_bold"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue5"
                android:padding="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToOutline="true"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/layoutEsqueceuSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:textColor="@color/black"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:textColorHint="@color/grey2"
                android:textSize="16sp"
                android:inputType="textEmailAddress"
                android:padding="13dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/letter"
                android:drawablePadding="8dp"/>

            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/senha"
                android:textColor="@color/black"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:textColorHint="@color/grey2"
                android:textSize="16sp"
                android:inputType="textPassword"
                android:padding="13dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/lock"
                android:drawablePadding="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:padding="13dp"
            android:text="@string/login"
            android:fontFamily="@font/istokweb_bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/green1"
            app:layout_constraintTop_toBottomOf="@id/boxLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
