<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue3"
    tools:context=".InicioFragment">

    <!-- Conteúdo rolável -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraInferior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="60dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- Cabeçalho -->
            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter24_bold"
                android:text="@string/hello"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layoutNavegacaoData"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSaudacao">

                <ImageView
                    android:id="@+id/btnDiaAnterior"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:src="@drawable/arrowprev"
                    android:textSize="30sp"
                    android:contentDescription="@string/last_day"
                    android:clickable="true"
                    app:tint="@color/white"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/txtData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter24_medium"
                    android:gravity="center"
                    android:text="@string/current_date"
                    android:textColor="@color/grey2"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnProximoDia"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:src="@drawable/arrownext"
                    app:tint="@color/white"
                    android:textSize="30sp"
                    android:contentDescription="@string/next_day"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Carrossel de banners -->
            <FrameLayout
                android:id="@+id/frameBanner"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_corner2"
                android:backgroundTint="@color/blue4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutNavegacaoData">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pagerBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/banner1" />

                <ImageView
                    android:id="@+id/arrowPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:contentDescription="@string/voltar"
                    android:src="@drawable/arrowprev"
                    android:visibility="visible"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/arrowNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:contentDescription="@string/go"
                    android:src="@drawable/arrownext"
                    android:visibility="visible"
                    app:tint="@color/white" />

                <LinearLayout
                    android:id="@+id/layoutIndicadores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal" />

            </FrameLayout>

            <!-- Faixa Gord. / Carb. / Prot. -->
            <LinearLayout
                android:id="@+id/pillMacros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_input"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/frameBanner">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/gord"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtGordura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter24_bold"
                        android:text="@string/daily_gord"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/carb"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCarbo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter24_bold"
                        android:text="@string/daily_carbo"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/prot"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtProteina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter24_bold"
                        android:text="@string/daily_prot"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txtRefeicoesHoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter24_bold"
                android:text="@string/today_meal"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pillMacros" />

            <!-- Card Registrar Refeições -->
            <LinearLayout
                android:id="@+id/cardRegistrarRefeicoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtRefeicoesHoje">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/green1">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/cutlery"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter24_bold"
                        android:text="@string/register_meal"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtCaloriasRefeicoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/register_value"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icAddRefeicao"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/plus"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- Card Água -->
            <LinearLayout
                android:id="@+id/cardAgua"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toStartOf="@id/cardIdr"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardRegistrarRefeicoes"
                app:layout_constraintWidth_percent="0.47">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/water"
                        app:tint="@color/green1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/water"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter24_bold"
                    android:text="@string/water_ml"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtML"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter24_medium"
                    android:text="@string/water_measure"
                    android:textColor="@color/grey2"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Card IDR -->
            <LinearLayout
                android:id="@+id/cardIdr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardAgua"
                app:layout_constraintTop_toBottomOf="@id/cardRegistrarRefeicoes"
                app:layout_constraintWidth_percent="0.47">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/arrowup"
                        app:tint="@color/green1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter24_medium"
                        android:text="@string/idr"
                        android:textColor="@color/grey2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtIdrValor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter24_bold"
                    android:text="@string/idr_value"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter24_medium"
                    android:text="@string/calories"
                    android:textColor="@color/grey2"
                    android:textSize="12sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra Inferior -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/blue2"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnUser"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:contentDescription="@string/profile"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/icuser" />

        <ImageView
            android:id="@+id/btnLivro"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:contentDescription="@string/diary"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/iclivrogr" />

        <ImageView
            android:id="@+id/btnScale"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="@string/calories"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/icescalawhite" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>