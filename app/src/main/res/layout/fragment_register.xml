<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue3"
    android:orientation="vertical">

    <!-- CABEÇALHO FIXO -->
    <LinearLayout
        android:id="@+id/headerFixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Linha do Título + Cancelar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter24_semibold"
                    android:text="@string/register_str"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dataReal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter24_regular"
                    android:text="@string/data"
                    android:textColor="@color/grey2"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/inter24_medium"
                android:text="@string/cancel"
                android:textColor="@color/green2"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Navegação por Abas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/alimentoAba"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter24_bold"
                    android:gravity="center"
                    android:text="@string/alimento"
                    android:textColor="@color/green2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/consumoAba"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter24_bold"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/consumido_recent"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/blue11" />

        <!-- BANNER DO CARRINHO (CORRIGIDO) -->
        <LinearLayout
            android:id="@+id/layoutCarrinhoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvItensCarrinho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter24_semibold"
                android:text="@string/alimento_add"
                android:textColor="@color/green2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnLimparCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter24_medium"
                android:padding="4dp"
                android:text="@string/limpar"
                android:textColor="@color/red"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTEÚDO COM SCROLL (Apenas Busca + Lista) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- Campo de Busca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/search_icon"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/grey2" />

                <EditText
                    android:id="@+id/etPesquisa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:textColorHint="@color/grey2"
                    android:textSize="15sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filtroTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/all"
                        android:fontFamily="@font/inter24_semibold"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="@color/green2"
                        android:textColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filtroProteinas"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/prot"
                        android:fontFamily="@font/inter24_semibold"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="@color/blue4"
                        android:textColor="@color/grey2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filtroCarboidratos"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/carb"
                        android:fontFamily="@font/inter24_semibold"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="@color/blue4"
                        android:textColor="@color/grey2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filtroLanches"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/lanches"
                        android:fontFamily="@font/inter24_semibold"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="@color/blue4"
                        android:textColor="@color/grey2" />

                </LinearLayout>

            </HorizontalScrollView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCustomFood"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/inter24_bold"
                android:text="@string/add_custom_food_str"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:listitem="@layout/item_alimento" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>