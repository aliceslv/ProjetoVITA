<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <!-- START FRAGMENT -->
    <fragment
        android:id="@+id/startFragment"
        android:name="com.example.vita.StartFragment"
        android:label="StartFragment"
        tools:layout="@layout/fragment_start">
        <action
            android:id="@+id/action_startFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_startFragment_to_cadastroFragment"
            app:destination="@id/cadastroFragment" />
    </fragment>

    <!-- LOGIN FRAGMENT -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.vita.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_cadastroFragment"
            app:destination="@id/cadastroFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotFragment"
            app:destination="@id/forgotFragment" />
        <action
            android:id="@+id/action_loginFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
    </fragment>

    <!-- FORGOT / RECUPERAR SENHA FRAGMENT -->
    <fragment
        android:id="@+id/forgotFragment"
        android:name="com.example.vita.ForgotFragment"
        android:label="ForgotFragment"
        tools:layout="@layout/fragment_forgot" />

    <!-- CADASTRO FRAGMENT -->
    <fragment
        android:id="@+id/cadastroFragment"
        android:name="com.example.vita.CadastroFragment"
        android:label="CadastroFragment"
        tools:layout="@layout/fragment_cadastro">
        <action
            android:id="@+id/action_cadastroFragment_to_goalsFragment"
            app:destination="@id/goalsFragment" />
        <action
            android:id="@+id/action_cadastroFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- GOALS FRAGMENT -->
    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.example.vita.GoalsFragment"
        android:label="GoalsFragment"
        tools:layout="@layout/fragment_goals">
        <action
            android:id="@+id/action_goalsFragment_to_informationsFragment"
            app:destination="@id/informationsFragment" />
    </fragment>

    <!-- INFORMATIONS FRAGMENT -->
    <fragment
        android:id="@+id/informationsFragment"
        android:name="com.example.vita.InformationsFragment"
        android:label="InformationsFragment"
        tools:layout="@layout/fragment_informations">
        <action
            android:id="@+id/action_informationsFragment_to_workoutFragment"
            app:destination="@id/workoutFragment" />
    </fragment>

    <!-- WORKOUT FRAGMENT -->
    <fragment
        android:id="@+id/workoutFragment"
        android:name="com.example.vita.WorkoutFragment"
        android:label="WorkoutFragment"
        tools:layout="@layout/fragment_workout">
        <action
            android:id="@+id/action_workoutFragment_to_idrFragment"
            app:destination="@id/idrFragment" />
    </fragment>

    <!-- IDR FRAGMENT -->
    <fragment
        android:id="@+id/idrFragment"
        android:name="com.example.vita.IdrFragment"
        android:label="IdrFragment"
        tools:layout="@layout/fragment_idr">
        <action
            android:id="@+id/action_idrFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
    </fragment>

    <!-- INICIO FRAGMENT -->
    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.example.vita.InicioFragment"
        android:label="InicioFragment"
        tools:layout="@layout/fragment_inicio">
        <action
            android:id="@+id/action_inicioFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_inicioFragment_to_caloriasFragment"
            app:destination="@id/caloriasFragment" />
        <action
            android:id="@+id/action_inicioFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- REGISTER FRAGMENT -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.vita.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_addFragment"
            app:destination="@id/addFragment" />
        <action
            android:id="@+id/action_registerFragment_to_recentFragment"
            app:destination="@id/recentFragment" />
        <action
            android:id="@+id/action_registerFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
    </fragment>

    <!-- ADD FRAGMENT -->
    <fragment
        android:id="@+id/addFragment"
        android:name="com.example.vita.AddFragment"
        android:label="AddFragment"
        tools:layout="@layout/fragment_add">
        <action
            android:id="@+id/action_addFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_addFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- RECENT FRAGMENT -->
    <fragment
        android:id="@+id/recentFragment"
        android:name="com.example.vita.RecentFragment"
        android:label="RecentFragment"
        tools:layout="@layout/fragment_recent">
        <action
            android:id="@+id/action_recentFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_recentFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- CALORIAS FRAGMENT -->
    <fragment
        android:id="@+id/caloriasFragment"
        android:name="com.example.vita.CaloriasFragment"
        android:label="CaloriasFragment"
        tools:layout="@layout/fragment_calorias">
        <action
            android:id="@+id/action_caloriasFragment_to_macrosFragment"
            app:destination="@id/macrosFragment" />
        <action
            android:id="@+id/action_caloriasFragment_to_nutriFragment"
            app:destination="@id/nutriFragment" />
        <action
            android:id="@+id/action_caloriasFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_caloriasFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- MACROS FRAGMENT -->
    <fragment
        android:id="@+id/macrosFragment"
        android:name="com.example.vita.MacrosFragment"
        android:label="MacrosFragment"
        tools:layout="@layout/fragment_macros">
        <action
            android:id="@+id/action_macrosFragment_to_caloriasFragment"
            app:destination="@id/caloriasFragment" />
        <action
            android:id="@+id/action_macrosFragment_to_nutriFragment"
            app:destination="@id/nutriFragment" />
        <action
            android:id="@+id/action_macrosFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_macrosFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- NUTRI FRAGMENT -->
    <fragment
        android:id="@+id/nutriFragment"
        android:name="com.example.vita.NutriFragment"
        android:label="NutriFragment"
        tools:layout="@layout/fragment_nutri">
        <action
            android:id="@+id/action_nutriFragment_to_caloriasFragment"
            app:destination="@id/caloriasFragment" />
        <action
            android:id="@+id/action_nutriFragment_to_macrosFragment"
            app:destination="@id/macrosFragment" />
        <action
            android:id="@+id/action_nutriFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_nutriFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- PROFILE FRAGMENT -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.vita.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_inicioFragment"
            app:destination="@id/inicioFragment" />
        <action
            android:id="@+id/action_profileFragment_to_caloriasFragment"
            app:destination="@id/caloriasFragment" />
        <action
            android:id="@+id/action_profileFragment_to_profileEditFragment"
            app:destination="@id/profileEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileEditFragment"
        android:name="com.example.vita.ProfileEditFragment"
        android:label="ProfileEditFragment"
        tools:layout="@layout/fragment_profile_edit">

        <action
            android:id="@+id/action_profileEditFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

</navigation>